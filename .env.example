# ============================================================================
#  Airflow environment variables
#  This file is read automatically by `docker compose`.
# ============================================================================

# The Airflow Docker image to use (pinned version = reproducible builds).
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5

# The Linux user-id that Airflow runs as INSIDE the containers.
# It MUST match your host user id so files written to ./dags, ./logs and
# ./output are owned by you (not by root) and stay editable.
#
#   On Linux / WSL2 run:   id -u    (usually 1000) and put that number here.
#   On macOS / Windows:    leave 50000 — it just works.
AIRFLOW_UID=50000

# Which executor to use. CeleryExecutor => tasks run on a separate worker
# process, brokered through Redis. This is what "real" Airflow clusters use.
AIRFLOW_EXECUTOR=CeleryExecutor

# Encryption key Airflow uses to store connection passwords / variables
# securely in the metadata DB. Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=generate-your-own-see-command-above

# The admin account that gets created automatically the first time you start.
# Use these to log in at http://localhost:8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# Extra pip packages installed into the containers on startup (space separated).
# Left empty because our learning DAG only uses Python's standard library.
_PIP_ADDITIONAL_REQUIREMENTS=
